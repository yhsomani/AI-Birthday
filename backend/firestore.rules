rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Entitlement status is readable only by the authenticated owner, writable only by server.
    match /users/{userId}/entitlement/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Encrypted zero-PII cloud backup envelope is readable & writable by the authenticated owner.
    match /users/{userId}/backup/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The mobile app's opt-in cloud backup data is scoped to the signed-in owner.
    // This data is intentionally stored in separate collections from server-only coordination state.
    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId &&
        collection in ['people', 'birthdays', 'drafts', 'reminderSettings'];
    }

    // The coordination ledger, entitlement writes, and unknown collections are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
