# Historical Firebase config for a different package; never activate or commit.
/app/google-services.json

# Tier-specific Android Firebase/OAuth configuration is supplied out of band.
/android/app/src/*/google-services.json

# Tier-specific iOS Firebase/OAuth configuration is supplied out of band.
/ios/Config/*/GoogleService-Info.plist

# Credentials, signing material, and local runtime configuration.
.env
.env.*
!.env.example
*.mobileprovision
*.p12
*.pem
*service-account*.json

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage
/backend/functions/coverage/
/release-evidence/
gha-creds-*.json

# Firebase Functions build and emulator output; deploy and CI rebuild from TypeScript source.
/backend/functions/lib/
/backend/functions/firestore-debug.log
/backend/functions/firebase-debug.log
/backend/firestore-debug.log
/firebase-debug.log

# Firebase Hosting output and private release approvals; CI/deploy rebuilds them.
/backend/hosting/public/
/backend/hosting/release-config.local.json

