{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birthday-autopilot.invalid/schemas/cloud-readonly-observation-report-v1.json",
  "title": "WishWell protected cloud read-only observation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "status",
    "sourceRevision",
    "observedAt",
    "mutationAuthorized",
    "project",
    "identities",
    "hostingReleaseControl",
    "workflow",
    "observed",
    "evidenceManifest",
    "rawArchive"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "birthday-autopilot-cloud-readonly-observation" },
    "status": { "const": "observed-not-approved" },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "observedAt": { "type": "string", "format": "date-time" },
    "mutationAuthorized": { "const": false },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "projectNumber",
        "androidAppId",
        "iosAppId",
        "webAppId",
        "hostingSiteId"
      ],
      "properties": {
        "projectId": { "type": "string" },
        "projectNumber": { "type": "string" },
        "androidAppId": { "type": "string" },
        "iosAppId": { "type": "string" },
        "webAppId": { "type": "string" },
        "hostingSiteId": { "type": "string" }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeServiceAccount", "auditServiceAccount"],
      "properties": {
        "runtimeServiceAccount": { "type": "string" },
        "auditServiceAccount": { "type": "string" }
      }
    },
    "hostingReleaseControl": {
      "$ref": "#/$defs/hostingReleaseControl"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "runId",
        "runAttempt",
        "workflowRef",
        "runUrl"
      ],
      "properties": {
        "repository": { "const": "yhsomani/AI-Birthday" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "runAttempt": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
        "workflowRef": { "type": "string" },
        "runUrl": { "type": "string", "format": "uri" }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firebaseApps",
        "hostingSiteResourceName",
        "projectResourceName"
      ],
      "properties": {
        "firebaseApps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["appId", "platform", "resourceName"],
            "properties": {
              "appId": { "type": "string" },
              "platform": { "enum": ["ANDROID", "IOS", "WEB"] },
              "resourceName": { "type": "string" }
            }
          }
        },
        "hostingSiteResourceName": { "type": "string" },
        "projectResourceName": { "type": "string" }
      }
    },
    "evidenceManifest": { "$ref": "#/$defs/file" },
    "rawArchive": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "hostingReleaseControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSecurityProjectId",
        "releaseSecurityProjectNumber",
        "repositoryId",
        "repositoryOwnerId",
        "applicationIamAnalysisScope",
        "releaseSecurityIamAnalysisScope",
        "applicationResourceAssetCount",
        "releaseSecurityResourceAssetCount",
        "githubGovernance",
        "identities",
        "admissionBucket",
        "bucketAccessPrincipalCount",
        "applicationAndClientBucketAccessCount",
        "applicationProjectCloudStorageEnabled",
        "hostingMutation",
        "auditLogging"
      ],
      "properties": {
        "releaseSecurityProjectId": { "$ref": "#/$defs/text" },
        "releaseSecurityProjectNumber": { "$ref": "#/$defs/id" },
        "repositoryId": { "$ref": "#/$defs/id" },
        "repositoryOwnerId": { "$ref": "#/$defs/id" },
        "applicationIamAnalysisScope": { "$ref": "#/$defs/text" },
        "releaseSecurityIamAnalysisScope": { "$ref": "#/$defs/text" },
        "applicationResourceAssetCount": { "$ref": "#/$defs/count" },
        "releaseSecurityResourceAssetCount": { "$ref": "#/$defs/count" },
        "githubGovernance": { "$ref": "#/$defs/githubGovernance" },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observer", "admissionReader", "deployer"],
          "properties": {
            "observer": { "$ref": "#/$defs/releaseIdentity" },
            "admissionReader": { "$ref": "#/$defs/releaseIdentity" },
            "deployer": { "$ref": "#/$defs/releaseIdentity" }
          }
        },
        "admissionBucket": { "$ref": "#/$defs/admissionBucket" },
        "bucketAccessPrincipalCount": { "$ref": "#/$defs/count" },
        "applicationAndClientBucketAccessCount": { "const": 0 },
        "applicationProjectCloudStorageEnabled": { "const": false },
        "hostingMutation": { "$ref": "#/$defs/hostingMutation" },
        "auditLogging": { "$ref": "#/$defs/auditLogging" }
      }
    },
    "githubGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizationId",
        "repositoryId",
        "branch",
        "branchProtectionEnforced",
        "requiredStatusChecksStrict",
        "sourceCi",
        "environmentIds",
        "reviewerIds",
        "auditEventIds"
      ],
      "properties": {
        "organizationId": { "$ref": "#/$defs/id" },
        "repositoryId": { "$ref": "#/$defs/id" },
        "branch": { "const": "main" },
        "branchProtectionEnforced": { "const": true },
        "requiredStatusChecksStrict": { "const": true },
        "sourceCi": { "$ref": "#/$defs/sourceCi" },
        "environmentIds": { "$ref": "#/$defs/environmentIds" },
        "reviewerIds": { "$ref": "#/$defs/reviewerIds" },
        "auditEventIds": { "$ref": "#/$defs/auditEventIds" }
      }
    },
    "sourceCi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregateCheckName",
        "aggregateCheckRunId",
        "requiredCheckAppId",
        "workflowPath",
        "workflowRunId",
        "workflowRunAttempt",
        "checkSuiteId",
        "sourceRevision",
        "conclusion"
      ],
      "properties": {
        "aggregateCheckName": {
          "const": "Release admission for exact source SHA"
        },
        "aggregateCheckRunId": { "$ref": "#/$defs/id" },
        "requiredCheckAppId": { "$ref": "#/$defs/id" },
        "workflowPath": { "const": ".github/workflows/ci.yml" },
        "workflowRunId": { "$ref": "#/$defs/id" },
        "workflowRunAttempt": { "$ref": "#/$defs/id" },
        "checkSuiteId": { "$ref": "#/$defs/id" },
        "sourceRevision": { "$ref": "#/$defs/revision" },
        "conclusion": { "const": "success" }
      }
    },
    "environmentIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud-production-readonly-audit",
        "hosting-production-readonly-live",
        "hosting-production-build",
        "hosting-production-admission",
        "hosting-production-deploy"
      ],
      "properties": {
        "cloud-production-readonly-audit": { "$ref": "#/$defs/id" },
        "hosting-production-readonly-live": { "$ref": "#/$defs/id" },
        "hosting-production-build": { "$ref": "#/$defs/id" },
        "hosting-production-admission": { "$ref": "#/$defs/id" },
        "hosting-production-deploy": { "$ref": "#/$defs/id" }
      }
    },
    "reviewerIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud-production-readonly-audit",
        "hosting-production-readonly-live",
        "hosting-production-build",
        "hosting-production-admission",
        "hosting-production-deploy"
      ],
      "properties": {
        "cloud-production-readonly-audit": { "$ref": "#/$defs/idList" },
        "hosting-production-readonly-live": { "$ref": "#/$defs/idList" },
        "hosting-production-build": { "$ref": "#/$defs/idList" },
        "hosting-production-admission": { "$ref": "#/$defs/idList" },
        "hosting-production-deploy": { "$ref": "#/$defs/idList" }
      }
    },
    "auditEventIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cloud-production-readonly-audit",
        "hosting-production-readonly-live",
        "hosting-production-build",
        "hosting-production-admission",
        "hosting-production-deploy"
      ],
      "properties": {
        "cloud-production-readonly-audit": { "$ref": "#/$defs/text" },
        "hosting-production-readonly-live": { "$ref": "#/$defs/text" },
        "hosting-production-build": { "$ref": "#/$defs/text" },
        "hosting-production-admission": { "$ref": "#/$defs/text" },
        "hosting-production-deploy": { "$ref": "#/$defs/text" }
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceAccount",
        "userManagedKeyCount",
        "wifProvider",
        "workflowPath",
        "protectedEnvironment",
        "subject",
        "attributeCondition",
        "attributeMapping",
        "admissionBucketPermissions",
        "impersonationPrincipal"
      ],
      "properties": {
        "serviceAccount": { "$ref": "#/$defs/text" },
        "userManagedKeyCount": { "const": 0 },
        "wifProvider": { "$ref": "#/$defs/text" },
        "workflowPath": { "$ref": "#/$defs/text" },
        "protectedEnvironment": { "$ref": "#/$defs/text" },
        "subject": { "$ref": "#/$defs/text" },
        "attributeCondition": { "$ref": "#/$defs/text" },
        "attributeMapping": {
          "type": "object",
          "minProperties": 6,
          "additionalProperties": { "type": "string" }
        },
        "admissionBucketPermissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "impersonationPrincipal": { "$ref": "#/$defs/text" }
      }
    },
    "admissionBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resourceName",
        "metageneration",
        "publicAccessPrevention",
        "uniformBucketLevelAccess",
        "versioningEnabled",
        "softDeleteRetentionSeconds",
        "retentionSeconds",
        "retentionLocked",
        "lifecycleDeleteAgeDays",
        "lifecycleMatchesPrefix",
        "releaseSecurityProjectBucketCount"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "resourceName": { "$ref": "#/$defs/text" },
        "metageneration": { "$ref": "#/$defs/id" },
        "publicAccessPrevention": { "const": "enforced" },
        "uniformBucketLevelAccess": { "const": true },
        "versioningEnabled": { "const": false },
        "softDeleteRetentionSeconds": { "const": 0 },
        "retentionSeconds": { "const": 900 },
        "retentionLocked": { "const": true },
        "lifecycleDeleteAgeDays": { "const": 1 },
        "lifecycleMatchesPrefix": {
          "const": "hosting-production-change-freezes/"
        },
        "releaseSecurityProjectBucketCount": { "const": 1 }
      }
    },
    "hostingMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteResourceName",
        "serviceAccount",
        "workflowPath",
        "mutationIdentityCount",
        "mutationWorkflowCount",
        "alternateMutationIdentityCount",
        "permissions"
      ],
      "properties": {
        "siteResourceName": { "$ref": "#/$defs/text" },
        "serviceAccount": { "$ref": "#/$defs/text" },
        "workflowPath": {
          "const": ".github/workflows/hosting-production-deploy.yml"
        },
        "mutationIdentityCount": { "const": 1 },
        "mutationWorkflowCount": { "const": 1 },
        "alternateMutationIdentityCount": { "const": 0 },
        "permissions": {
          "const": [
            "firebasehosting.sites.create",
            "firebasehosting.sites.delete",
            "firebasehosting.sites.update"
          ]
        }
      }
    },
    "auditLogging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "logTypes",
        "exemptedMembers",
        "sinkName",
        "sinkDestination",
        "sinkFilter",
        "sinkDisabled",
        "sinkExclusions",
        "logBucketName",
        "logBucketLocation",
        "retentionDays"
      ],
      "properties": {
        "service": { "const": "storage.googleapis.com" },
        "logTypes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "exemptedMembers": { "const": [] },
        "sinkName": { "$ref": "#/$defs/text" },
        "sinkDestination": { "$ref": "#/$defs/text" },
        "sinkFilter": { "$ref": "#/$defs/text" },
        "sinkDisabled": { "const": false },
        "sinkExclusions": { "const": [] },
        "logBucketName": { "$ref": "#/$defs/text" },
        "logBucketLocation": { "$ref": "#/$defs/text" },
        "retentionDays": { "type": "integer", "minimum": 30 }
      }
    },
    "text": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "count": { "type": "integer", "minimum": 0 },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
