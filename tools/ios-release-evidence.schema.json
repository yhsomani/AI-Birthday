{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birthday-autopilot.invalid/schemas/ios-release-evidence-v1.json",
  "title": "Birthday Autopilot iOS authority-approved release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "product",
    "status",
    "sourceRevision",
    "artifact",
    "firebase",
    "signing",
    "security",
    "references",
    "approvals"
  ],
  "properties": {
    "$schema": { "const": "./ios-release-evidence.schema.json" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "birthday-autopilot-ios" },
    "status": { "const": "approved" },
    "sourceRevision": { "$ref": "#/$defs/revision" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveTreeSha256",
        "ipaSha256",
        "exportOptionsSha256",
        "bundleIdentifier",
        "marketingVersion",
        "buildNumber",
        "minimumOSVersion",
        "platform",
        "appBinarySha256",
        "embeddedFrameworksManifestSha256"
      ],
      "properties": {
        "archiveTreeSha256": { "$ref": "#/$defs/sha256" },
        "ipaSha256": { "$ref": "#/$defs/sha256" },
        "exportOptionsSha256": { "$ref": "#/$defs/sha256" },
        "bundleIdentifier": {
          "const": "com.yashsomani.birthdayautopilot"
        },
        "marketingVersion": { "$ref": "#/$defs/version" },
        "buildNumber": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,17}$"
        },
        "minimumOSVersion": { "const": "15.1" },
        "platform": { "const": "iphoneos" },
        "appBinarySha256": { "$ref": "#/$defs/sha256" },
        "embeddedFrameworksManifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "firebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "projectId",
        "projectNumber",
        "googleAppId",
        "oauthClientId",
        "reversedClientId",
        "configSha256",
        "apiKeySha256"
      ],
      "properties": {
        "environment": { "const": "prod" },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "projectNumber": {
          "type": "string",
          "pattern": "^[1-9][0-9]{5,19}$"
        },
        "googleAppId": {
          "type": "string",
          "pattern": "^1:[1-9][0-9]{5,19}:ios:[0-9a-f]{8,64}$"
        },
        "oauthClientId": {
          "type": "string",
          "pattern": "^[0-9]+-[a-z0-9-]+\\.apps\\.googleusercontent\\.com$"
        },
        "reversedClientId": {
          "type": "string",
          "pattern": "^com\\.googleusercontent\\.apps\\.[A-Za-z0-9-]+$"
        },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "apiKeySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distributionMethod",
        "teamIdentifier",
        "archiveCertificateExpiration",
        "archiveCertificateSha256",
        "exportedCertificateExpiration",
        "exportedCertificateSha256",
        "archiveProvisioningProfileUuid",
        "archiveProvisioningProfileName",
        "archiveProvisioningProfileExpiration",
        "exportedProvisioningProfileUuid",
        "exportedProvisioningProfileName",
        "exportedProvisioningProfileExpiration",
        "applicationIdentifier"
      ],
      "properties": {
        "distributionMethod": { "const": "app-store-connect" },
        "teamIdentifier": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        },
        "archiveCertificateExpiration": { "$ref": "#/$defs/instant" },
        "archiveCertificateSha256": { "$ref": "#/$defs/sha256" },
        "exportedCertificateExpiration": { "$ref": "#/$defs/instant" },
        "exportedCertificateSha256": { "$ref": "#/$defs/sha256" },
        "archiveProvisioningProfileUuid": { "$ref": "#/$defs/profileUuid" },
        "archiveProvisioningProfileName": { "$ref": "#/$defs/profileName" },
        "archiveProvisioningProfileExpiration": { "$ref": "#/$defs/instant" },
        "exportedProvisioningProfileUuid": { "$ref": "#/$defs/profileUuid" },
        "exportedProvisioningProfileName": { "$ref": "#/$defs/profileName" },
        "exportedProvisioningProfileExpiration": { "$ref": "#/$defs/instant" },
        "applicationIdentifier": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}\\.com\\.yashsomani\\.birthdayautopilot$"
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entitlementsSha256",
        "infoPlistSha256",
        "privacyManifestSha256",
        "arm64Only",
        "debugEntitlementAbsent",
        "appAttestProduction",
        "backupExclusionVerified",
        "protectedStoreVerified",
        "debugProviderAbsent",
        "noForbiddenCapabilities",
        "noForbiddenUrlSchemes",
        "privacyManifestReviewed"
      ],
      "properties": {
        "entitlementsSha256": { "$ref": "#/$defs/sha256" },
        "infoPlistSha256": { "$ref": "#/$defs/sha256" },
        "privacyManifestSha256": { "$ref": "#/$defs/sha256" },
        "arm64Only": { "const": true },
        "debugEntitlementAbsent": { "const": true },
        "appAttestProduction": { "const": true },
        "backupExclusionVerified": { "const": true },
        "protectedStoreVerified": { "const": true },
        "debugProviderAbsent": { "const": true },
        "noForbiddenCapabilities": { "const": true },
        "noForbiddenUrlSchemes": { "const": true },
        "privacyManifestReviewed": { "const": true }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactProvenance",
        "mobileSbom",
        "nativeSbom",
        "dependencyAudit",
        "firebaseReview",
        "protectedStorageBackup",
        "physicalDeviceMatrix",
        "performance",
        "accessibility",
        "privacyReview",
        "appStoreSubmission",
        "loginServicesReview",
        "accountDeletion",
        "incidentRollback"
      ],
      "properties": {
        "artifactProvenance": { "$ref": "#/$defs/reference" },
        "mobileSbom": { "$ref": "#/$defs/reference" },
        "nativeSbom": { "$ref": "#/$defs/reference" },
        "dependencyAudit": { "$ref": "#/$defs/reference" },
        "firebaseReview": { "$ref": "#/$defs/reference" },
        "protectedStorageBackup": { "$ref": "#/$defs/reference" },
        "physicalDeviceMatrix": { "$ref": "#/$defs/reference" },
        "performance": { "$ref": "#/$defs/reference" },
        "accessibility": { "$ref": "#/$defs/reference" },
        "privacyReview": { "$ref": "#/$defs/reference" },
        "appStoreSubmission": { "$ref": "#/$defs/reference" },
        "loginServicesReview": { "$ref": "#/$defs/reference" },
        "accountDeletion": { "$ref": "#/$defs/reference" },
        "incidentRollback": { "$ref": "#/$defs/reference" }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedAt",
        "validUntil",
        "nativeSupplyChainReviewed",
        "firebaseAndAppCheckVerified",
        "protectedStorageAndBackupVerified",
        "physicalDeviceMatrixPassed",
        "performanceBudgetsPassed",
        "accessibilityPassed",
        "privacyMaterialsApproved",
        "appStoreSubmissionMaterialsApproved",
        "loginServicesRationaleApproved",
        "accountDeletionVerified",
        "rollbackAndIncidentReady",
        "companionOnlyClaimsApproved",
        "noBackgroundSmsVerified"
      ],
      "properties": {
        "approvedAt": { "$ref": "#/$defs/instant" },
        "validUntil": { "$ref": "#/$defs/instant" },
        "nativeSupplyChainReviewed": { "const": true },
        "firebaseAndAppCheckVerified": { "const": true },
        "protectedStorageAndBackupVerified": { "const": true },
        "physicalDeviceMatrixPassed": { "const": true },
        "performanceBudgetsPassed": { "const": true },
        "accessibilityPassed": { "const": true },
        "privacyMaterialsApproved": { "const": true },
        "appStoreSubmissionMaterialsApproved": { "const": true },
        "loginServicesRationaleApproved": { "const": true },
        "accountDeletionVerified": { "const": true },
        "rollbackAndIncidentReady": { "const": true },
        "companionOnlyClaimsApproved": { "const": true },
        "noBackgroundSmsVerified": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "profileUuid": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
    },
    "profileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
