{
  "name": "relateai-react-native",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,js,cjs}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,js,cjs}\"",
    "test": "tsx --test --test-isolation=none src/**/*.test.ts",
    "test:coverage": "tsx --test --test-isolation=none --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 src/**/*.test.ts",
    "test:native-prebuild": "node scripts/verify_native_prebuild.js",
    "web:export": "expo export --platform web --output-dir reports/web-export",
    "release:evidence": "tsx src/config/releaseEvidenceCli.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.4",
    "expo-calendar": "^57.0.0",
    "expo-contacts": "^57.0.0",
    "expo-crypto": "57.0.0",
    "expo-document-picker": "^57.0.0",
    "expo-file-system": "^57.0.0",
    "expo-local-authentication": "^57.0.0",
    "expo-notifications": "^57.0.3",
    "expo-secure-store": "^57.0.0",
    "expo-sharing": "^57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "9.39.4",
    "eslint-config-expo": "57.0.0",
    "prettier": "3.9.5",
    "tsx": "^4.23.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
