# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

project 'BirthdayAutopilot',
  'Debug' => :debug,
  'E2E' => :debug,
  'Smoke' => :debug,
  'Release' => :release

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BirthdayAutopilot' do
  config = use_native_modules!

  # Native-only identity and Contacts boundary. Versions remain exact until a
  # reviewed dependency update refreshes Podfile.lock and the release evidence.
  # Firebase's current 2nd-generation callable interoperability floor is
  # 12.15.0. Keep every Firebase pod on the same exact release.
  pod 'FirebaseCore', '12.15.0'
  pod 'FirebaseAuth', '12.15.0'
  pod 'FirebaseAppCheck', '12.15.0', :modular_headers => true
  pod 'FirebaseAILogic', '12.15.0'
  pod 'FirebaseFunctions', '12.15.0'
  pod 'FirebaseRemoteConfig', '12.15.0'
  # Firebase's Swift pods are linked statically by the React Native target.
  # Generate modules only for the Objective-C interoperability leaves that
  # Swift imports; avoid globally changing every React Native pod header mode.
  pod 'FirebaseAppCheckInterop', '12.15.0', :modular_headers => true
  pod 'FirebaseABTesting', '12.15.0', :modular_headers => true
  pod 'FirebaseAuthInterop', '12.15.0', :modular_headers => true
  pod 'FirebaseMessagingInterop', '12.15.0', :modular_headers => true
  pod 'GoogleUtilities', '8.1.2', :modular_headers => true
  pod 'RecaptchaInterop', '101.0.0', :modular_headers => true
  pod 'GoogleSignIn', '9.1.0'
  # BA-04 must use the maintained Google-libphonenumber metadata port for
  # canonical E.164/type validation and its dedicated short-number metadata
  # for emergency/short-code/cost rejection. Keep the two Swift facades on the
  # same exact release; parsing success alone is never SMS capability proof.
  # The facade podspecs use pessimistic transitive constraints, so pin the
  # Objective-C metadata owners too; otherwise a later 1.7.x dataset can enter
  # a nominally 1.7.3 build. Modular headers are limited to these dependencies
  # because React Native links this target as static libraries.
  pod 'libPhoneNumber-iOS', '1.7.3', :modular_headers => true
  pod 'libPhoneNumberShortNumber', '1.7.3', :modular_headers => true
  pod 'libPhoneNumber-iOS-SwiftCore', '1.7.3'
  pod 'libPhoneNumber-iOS-SwiftShortNumber', '1.7.3'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
