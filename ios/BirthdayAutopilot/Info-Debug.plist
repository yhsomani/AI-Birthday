<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key><true/>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Birthday Autopilot</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key><string>????</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>BirthdayExpectedFirebaseProjectID</key><string>$(BIRTHDAY_FIREBASE_PROJECT_ID)</string>
	<key>BirthdayFirebaseEnvironment</key><string>$(BIRTHDAY_FIREBASE_ENV)</string>
	<key>BirthdayGoogleConfigurationRequired</key><string>$(BIRTHDAY_FIREBASE_CONFIG_REQUIRED)</string>
	<key>BirthdayGoogleReversedClientID</key><string>$(BIRTHDAY_GOOGLE_REVERSED_CLIENT_ID)</string>
	<key>BirthdayLedgerGeneration</key><string>$(BIRTHDAY_LEDGER_GENERATION)</string>
	<key>CFBundleURLTypes</key>
	<array><dict>
		<key>CFBundleTypeRole</key><string>Editor</string>
		<key>CFBundleURLSchemes</key>
		<array><string>$(BIRTHDAY_GOOGLE_REVERSED_CLIENT_ID)</string></array>
	</dict></array>
	<key>FirebaseAppCheckTokenAutoRefreshEnabled</key><true/>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key><false/>
		<!-- Metro is development-only; Release uses Info.plist with this disabled. -->
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
	<key>UILaunchStoryboardName</key><string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<key>UIViewControllerBasedStatusBarAppearance</key><false/>
</dict>
</plist>
