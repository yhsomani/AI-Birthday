# These EXPO_PUBLIC_ values are embedded in the client bundle. Never put API
# keys, OAuth tokens, SMTP credentials, signing secrets, or provider secrets here.

# Optional HTTPS backend that accepts RelateAI's sanitized AI-drafting payload.
EXPO_PUBLIC_RELATE_AI_ENDPOINT=

# Optional HTTPS backend that sends an already approved email message.
EXPO_PUBLIC_RELATE_EMAIL_ENDPOINT=

# Optional HTTPS backend that reconciles an existing idempotent email attempt.
# It receives only provider attempt identifiers, never message content.
EXPO_PUBLIC_RELATE_EMAIL_STATUS_ENDPOINT=

# Development only. Keep false/unset in release builds. When true, explicitly
# configured localhost/private-network provider endpoints may be used for testing.
EXPO_PUBLIC_RELATE_ALLOW_LOCAL_PROVIDER_ENDPOINTS=false
