# =============================================================================
# WishWell / RelateAI — Environment Template
# =============================================================================
# Copy to `.env` (never commit the real file) and fill in values per deployment.
#
#   cp .env.example .env
#
# CONVENTIONS
#   *_SECRET_KEY  -> Firebase Functions SECRET param (defineSecret). Set with:
#                    firebase functions:secrets:set <NAME>   (from ./backend)
#                    or:  echo -n "value" | firebase functions:secrets:set <NAME>
#   *_PARAM       -> Firebase Functions STRING/JSON param (defineString /
#                    defineJsonSecret). Set with:
#                    firebase functions:config:set  /  firebase deploy --only functions:params
#   VITE_*        -> build-time public value for the web hosting bundle
#                    (backend/hosting). Anything here is PUBLIC by design.
#
# NOTHING in this file may hold a real credential. All values below are
# placeholders.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. STRIPE — billing / entitlement activation (Phase 2 of the roadmap)
# -----------------------------------------------------------------------------
# Secret key: SERVER ONLY. Used by webhook signature verification and by the
# Checkout Session / Customer Portal creation endpoints. Never ship this to the
# mobile app, the web bundle, or a repository.
#   Live:       sk_live_...     Test:  sk_test_...
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Publishable key: SAFE for clients (React Native app + web hosting). Drives
# Stripe.js / Checkout redirects. Must match the secret key's mode (test vs live).
#   Live:       pk_live_...     Test:  pk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Same publishable key exposed to the Vite web bundle (public by definition).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Webhook signing secret for the endpoint that receives `checkout.session.*`,
# `customer.subscription.*` and `invoice.payment_failed`. Created by Stripe when
# you register the endpoint; used with stripe.webhooks.constructEvent().
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# API version pin (keeps webhook payload shape stable across upgrades).
STRIPE_API_VERSION=2026-06-24.basil

# Default currency for WishWell plans (INR pricing model).
STRIPE_CURRENCY=inr

# --- Product / Price identifiers ---------------------------------------------
# Map Stripe Prices onto WishWell plan ids. These feed SKU_TO_PLAN in
# backend/functions/src/services/subscriptionIngestion.ts, which is the ONLY
# writer of users/{uid}/meta/aiEntitlement.
# Plan ids (closed vocabulary, see domain/aiModel.ts): free | wishwell-plus
STRIPE_PRICE_WISHWELL_PLUS_MONTHLY=price_REPLACE_ME_monthly_inr499
STRIPE_PRICE_WISHWELL_PLUS_YEARLY=price_REPLACE_ME_yearly_inr4990

# Existing Play-store SKUs (kept for parity with RTDN ingestion):
#   wishwell_plus_monthly | wishwell_plus_yearly | wishwell_plus_test


# -----------------------------------------------------------------------------
# 2. AI GATEWAY — provider credentials (Firebase Functions, region asia-south1)
# -----------------------------------------------------------------------------
# Gemini API key. SECRET PARAM: AI_GATEWAY_GEMINI_API_KEY
# Only consumed when AI_GATEWAY_PROVIDER_MODE=gemini-rest.
GEMINI_API_KEY=REPLACE_ME

# Provider mode: 'stub' keeps the gateway offline-deterministic in dev/emulator
# deploys; 'gemini-rest' enables real calls. PARAM: AI_GATEWAY_PROVIDER_MODE
AI_GATEWAY_PROVIDER_MODE=stub

# Global monthly cloud-cost ceiling, in micro-rupees (₹5,000 = 5000000000).
# PARAM: AI_GATEWAY_MONTHLY_BUDGET_MICROS
AI_GATEWAY_MONTHLY_BUDGET_MICROS=5000000000


# -----------------------------------------------------------------------------
# 3. CONTROL PLANE — coordination & auth (existing required params)
# -----------------------------------------------------------------------------
# HMAC key ring for sender fencing. JSON SECRET PARAM: COORDINATION_HMAC_KEYRING
COORDINATION_HMAC_KEYRING={"active":"base64:REPLACE_ME","previous":[]}

# Service account the functions run as. PARAM: CONTROL_PLANE_SERVICE_ACCOUNT
CONTROL_PLANE_SERVICE_ACCOUNT=control-plane@REPLACE_PROJECT.iam.gserviceaccount.com

# Firebase project id (see backend/.firebaserc; demo-* is emulator-only).
FIREBASE_PROJECT_ID=demo-birthday-autopilot


# -----------------------------------------------------------------------------
# 4. WEB HOSTING — public runtime config (backend/hosting)
# -----------------------------------------------------------------------------
# Firebase App Check Enterprise site key (public). Mirrors
# release-config.example.json -> recaptchaEnterpriseSiteKey
RECAPTCHA_ENTERPRISE_SITE_KEY=REPLACE_ME_site_key
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=REPLACE_ME_site_key

# Canonical https origin for links, redirects and legal pages.
PUBLIC_BASE_URL=https://REPLACE_ME.web.app


# -----------------------------------------------------------------------------
# 5. LOCAL DEVELOPMENT / EMULATORS (never enable in production)
# -----------------------------------------------------------------------------
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FUNCTIONS_EMULATOR_PORT=5001
